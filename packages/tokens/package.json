{
  "name": "@uix/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for design decisions. W3C DTCG-format tokens compiled to CSS custom properties and TypeScript.",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@uix/config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
