{
  "color": {
    "gray": {
      "50": { "$type": "color", "$value": "#fafaf9" },
      "100": { "$type": "color", "$value": "#f5f5f4" },
      "200": { "$type": "color", "$value": "#e7e5e4" },
      "300": { "$type": "color", "$value": "#d6d3d1" },
      "400": { "$type": "color", "$value": "#a8a29e" },
      "500": { "$type": "color", "$value": "#78716c" },
      "600": { "$type": "color", "$value": "#57534e" },
      "700": { "$type": "color", "$value": "#44403c" },
      "800": { "$type": "color", "$value": "#292524" },
      "900": { "$type": "color", "$value": "#1c1917" },
      "950": { "$type": "color", "$value": "#0c0a09" }
    },
    "ember": {
      "50": { "$type": "color", "$value": "#fff7ed" },
      "100": { "$type": "color", "$value": "#ffedd5" },
      "200": { "$type": "color", "$value": "#fed7aa" },
      "300": { "$type": "color", "$value": "#fdba74" },
      "400": { "$type": "color", "$value": "#fb923c" },
      "500": { "$type": "color", "$value": "#f97316" },
      "600": { "$type": "color", "$value": "#ea580c" },
      "700": { "$type": "color", "$value": "#c2410c" },
      "800": { "$type": "color", "$value": "#9a3412" },
      "900": { "$type": "color", "$value": "#7c2d12" },
      "950": { "$type": "color", "$value": "#431407" }
    },
    "teal": {
      "50": { "$type": "color", "$value": "#f0fdfa" },
      "100": { "$type": "color", "$value": "#ccfbf1" },
      "200": { "$type": "color", "$value": "#99f6e4" },
      "300": { "$type": "color", "$value": "#5eead4" },
      "400": { "$type": "color", "$value": "#2dd4bf" },
      "500": { "$type": "color", "$value": "#14b8a6" },
      "600": { "$type": "color", "$value": "#0d9488" },
      "700": { "$type": "color", "$value": "#0f766e" },
      "800": { "$type": "color", "$value": "#115e59" },
      "900": { "$type": "color", "$value": "#134e4a" },
      "950": { "$type": "color", "$value": "#042f2e" }
    },
    "green": {
      "100": { "$type": "color", "$value": "#dcfce7" },
      "400": { "$type": "color", "$value": "#4ade80" },
      "600": { "$type": "color", "$value": "#16a34a" },
      "700": { "$type": "color", "$value": "#15803d" }
    },
    "amber": {
      "100": { "$type": "color", "$value": "#fef3c7" },
      "400": { "$type": "color", "$value": "#fbbf24" },
      "600": { "$type": "color", "$value": "#d97706" },
      "700": { "$type": "color", "$value": "#b45309" }
    },
    "red": {
      "100": { "$type": "color", "$value": "#fee2e2" },
      "400": { "$type": "color", "$value": "#f87171" },
      "600": { "$type": "color", "$value": "#dc2626" },
      "700": { "$type": "color", "$value": "#b91c1c" }
    },
    "blue": {
      "100": { "$type": "color", "$value": "#dbeafe" },
      "400": { "$type": "color", "$value": "#60a5fa" },
      "600": { "$type": "color", "$value": "#2563eb" },
      "700": { "$type": "color", "$value": "#1d4ed8" }
    },
    "white": { "$type": "color", "$value": "#ffffff" },
    "black": { "$type": "color", "$value": "#000000" },
    "semantic": {
      "surface": {
        "default": {
          "$type": "color",
          "$value": { "light": "{color.white}", "dark": "{color.gray.950}" },
          "$description": "Page background"
        },
        "raised": {
          "$type": "color",
          "$value": { "light": "{color.gray.50}", "dark": "{color.gray.900}" },
          "$description": "Cards, header bars"
        },
        "overlay": {
          "$type": "color",
          "$value": { "light": "{color.white}", "dark": "{color.gray.800}" },
          "$description": "Dialogs, popovers"
        },
        "sunken": {
          "$type": "color",
          "$value": { "light": "{color.gray.100}", "dark": "{color.black}" },
          "$description": "Code blocks, wells"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": { "light": "{color.gray.900}", "dark": "{color.gray.50}" }
        },
        "secondary": {
          "$type": "color",
          "$value": { "light": "{color.gray.600}", "dark": "{color.gray.300}" }
        },
        "muted": {
          "$type": "color",
          "$value": { "light": "{color.gray.500}", "dark": "{color.gray.400}" }
        },
        "inverse": {
          "$type": "color",
          "$value": { "light": "{color.gray.50}", "dark": "{color.gray.950}" }
        },
        "accent": {
          "$type": "color",
          "$value": { "light": "{color.ember.700}", "dark": "{color.ember.400}" }
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": { "light": "{color.gray.200}", "dark": "{color.gray.800}" }
        },
        "strong": {
          "$type": "color",
          "$value": { "light": "{color.gray.300}", "dark": "{color.gray.700}" }
        },
        "focus": {
          "$type": "color",
          "$value": { "light": "{color.ember.500}", "dark": "{color.ember.400}" },
          "$description": "Focus-visible ring color"
        }
      },
      "interactive": {
        "primary": {
          "default": {
            "$type": "color",
            "$value": { "light": "{color.ember.600}", "dark": "{color.ember.500}" }
          },
          "hover": {
            "$type": "color",
            "$value": { "light": "{color.ember.700}", "dark": "{color.ember.400}" }
          },
          "active": {
            "$type": "color",
            "$value": { "light": "{color.ember.800}", "dark": "{color.ember.300}" }
          },
          "text": {
            "$type": "color",
            "$value": { "light": "{color.white}", "dark": "{color.gray.950}" },
            "$description": "On-primary label color, tuned per mode for contrast"
          }
        },
        "secondary": {
          "default": {
            "$type": "color",
            "$value": { "light": "{color.gray.100}", "dark": "{color.gray.800}" }
          },
          "hover": {
            "$type": "color",
            "$value": { "light": "{color.gray.200}", "dark": "{color.gray.700}" }
          },
          "text": {
            "$type": "color",
            "$value": { "light": "{color.gray.900}", "dark": "{color.gray.50}" }
          }
        }
      },
      "feedback": {
        "success": {
          "fg": {
            "$type": "color",
            "$value": { "light": "{color.green.700}", "dark": "{color.green.400}" }
          },
          "bg": {
            "$type": "color",
            "$value": { "light": "{color.green.100}", "dark": "rgba(34, 197, 94, 0.12)" }
          }
        },
        "warning": {
          "fg": {
            "$type": "color",
            "$value": { "light": "{color.amber.700}", "dark": "{color.amber.400}" }
          },
          "bg": {
            "$type": "color",
            "$value": { "light": "{color.amber.100}", "dark": "rgba(245, 158, 11, 0.12)" }
          }
        },
        "danger": {
          "fg": {
            "$type": "color",
            "$value": { "light": "{color.red.700}", "dark": "{color.red.400}" }
          },
          "bg": {
            "$type": "color",
            "$value": { "light": "{color.red.100}", "dark": "rgba(239, 68, 68, 0.12)" }
          }
        },
        "info": {
          "fg": {
            "$type": "color",
            "$value": { "light": "{color.blue.700}", "dark": "{color.blue.400}" }
          },
          "bg": {
            "$type": "color",
            "$value": { "light": "{color.blue.100}", "dark": "rgba(59, 130, 246, 0.12)" }
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
      },
      "display": {
        "$type": "fontFamily",
        "$value": "'Space Grotesk', Inter, system-ui, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'JetBrains Mono', ui-monospace, 'Cascadia Code', Menlo, monospace"
      }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" },
      "4xl": { "$type": "dimension", "$value": "2.25rem" },
      "5xl": { "$type": "dimension", "$value": "3rem" },
      "6xl": { "$type": "dimension", "$value": "3.75rem" },
      "7xl": { "$type": "dimension", "$value": "4.5rem" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": "1.1" },
      "snug": { "$type": "number", "$value": "1.25" },
      "normal": { "$type": "number", "$value": "1.5" },
      "relaxed": { "$type": "number", "$value": "1.7" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold": { "$type": "fontWeight", "$value": "700" }
    },
    "tracking": {
      "tight": { "$type": "dimension", "$value": "-0.02em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.02em" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "16px" },
    "2xl": { "$type": "dimension", "$value": "24px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(28, 25, 23, 0.06)" },
    "md": { "$type": "shadow", "$value": "0 2px 8px rgba(28, 25, 23, 0.08)" },
    "lg": { "$type": "shadow", "$value": "0 8px 24px rgba(28, 25, 23, 0.12)" },
    "xl": { "$type": "shadow", "$value": "0 16px 48px rgba(28, 25, 23, 0.16)" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "100ms" },
      "fast": { "$type": "duration", "$value": "150ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "300ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "entrance": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "exit": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" },
    "2xl": { "$type": "dimension", "$value": "1536px" }
  },
  "z-index": {
    "base": { "$type": "number", "$value": "0" },
    "raised": { "$type": "number", "$value": "10" },
    "sticky": { "$type": "number", "$value": "100" },
    "dropdown": { "$type": "number", "$value": "1000" },
    "overlay": { "$type": "number", "$value": "1200" },
    "modal": { "$type": "number", "$value": "1300" },
    "toast": { "$type": "number", "$value": "1400" }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": "0.55" },
    "subtle": { "$type": "number", "$value": "0.08" }
  },
  "content": {
    "prose": { "$type": "dimension", "$value": "65ch" },
    "md": { "$type": "dimension", "$value": "48rem" },
    "lg": { "$type": "dimension", "$value": "64rem" },
    "xl": { "$type": "dimension", "$value": "80rem" }
  }
}
