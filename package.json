{
  "name": "uix",
  "version": "0.1.0",
  "private": true,
  "description": "openxcraft UI/UX monorepo — shared design tokens, component packages, platform templates, and product workspaces.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
